{
  "description": "Canonical DSR ticker sources. Keep source files separate; HA workflow unions and deduplicates all tickers while retaining source membership.",
  "sources": [
    {
      "name": "Sector Top Tickers",
      "path": "tickers.txt",
      "format": "whitespace"
    },
    {
      "name": "Finviz",
      "path": "finviz_tickers.csv",
      "format": "csv"
    },
    {
      "name": "Simpel Monsters",
      "path": "data/simpel_monsters_tickers.csv",
      "format": "csv"
    },
    {
      "name": "Follow Thrue",
      "path": "data/follow_thrue_tickers.csv",
      "format": "csv"
    },
    {
      "name": "VYUS holdings",
      "path": "data/vyus_tickers.csv",
      "format": "csv"
    }
  ],
  "excluded_indicators": [
    "SMA200"
  ],
  "included_indicators": [
    "SMA20",
    "SMA50",
    "daily_volume",
    "average_volume_5d",
    "average_volume_21d",
    "rvol_5_21",
    "volume_trend_3d",
    "Heikin-Ashi"
  ],
  "volume_calculation": {
    "method": "RVOL 5/21",
    "formula": "average daily volume over latest 5 fully completed regular trading sessions divided by average daily volume over latest 21 fully completed regular trading sessions",
    "intraday_sessions_excluded": true,
    "thresholds": {
      "<0.80": "zwak",
      "0.80-<1.00": "beneden gemiddeld",
      "1.00-<1.25": "neutraal",
      "1.25-<1.50": "positief",
      "1.50-2.00": "sterk",
      ">2.00": "zeer sterk"
    }
  }
}
